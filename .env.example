# --- required ---------------------------------------------------------------

# Neon Postgres. Use the POOLED endpoint (-pooler in the hostname): Render keeps
# many connections open and restarts drop them, so Neon's pooler should hold them.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# One model provider. XAI is tried first, then Anthropic, then OpenAI.
XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MODEL_ID=grok-4.6
# FAST_MODEL_ID=

# Exa answers "who or what exists that matches this".
EXA_API_KEY=
# Firecrawl answers "what does this specific page actually say".
FIRECRAWL_API_KEY=

# --- optional: linkedin ------------------------------------------------------
# Up2Data answers "who holds this role at this kind of company" — the LinkedIn
# people search, plus live firmographics and the profile endpoint that reads the
# one page Firecrawl cannot. Without it the loop runs on Exa and Firecrawl alone:
# the LinkedIn search is skipped, not failed.
# Billed per success: 1 credit per page of 25 results, 1 per profile or company.
# UP2DATA_API_KEY=

# --- deployment -------------------------------------------------------------

# Absolute origin. OAuth redirects and fallback storage URLs are built from it.
APP_URL=http://localhost:3000

# --- optional: object storage ------------------------------------------------
# Without these, uploads and the scrape cache fall back to a Postgres table.
# That works, but it proxies bytes through the app server, which is not what you
# want on a small instance that is also running graph work.
# NEON_STORAGE_BUCKET=
# NEON_STORAGE_ENDPOINT=
# NEON_STORAGE_REGION=auto
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=

# --- optional: Gmail ---------------------------------------------------------
# Without these, drafting and approval work but sending is disabled.
# Scope is gmail.send only. Keep the OAuth client in testing mode with your demo
# accounts added as test users; production verification for the send scope takes
# weeks, so start it now if this outlives the hackathon.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/gmail/callback
# 32 bytes, as 64 hex chars or base64. Generate: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=

# --- optional: contact enrichment -------------------------------------------
# Any provider that takes { fullName, company, domain, profileUrl } and returns
# { email, phone }. Without it, contacts come only from what a page publishes,
# and leads without one are marked unresolved rather than guessed at.
# ENRICHMENT_API_URL=
# ENRICHMENT_API_KEY=

# --- optional: budgets and tuning -------------------------------------------
# RUN_BUDGET_CANDIDATES=120
# RUN_BUDGET_SECONDS=600
# RUN_BUDGET_TOKENS=2000000
# PG_POOL_MAX=8
# Providers meter per minute; these caps are process-wide, not per call site.
# FIRECRAWL_CONCURRENCY=3
# EXA_CONCURRENCY=4
# UP2DATA_CONCURRENCY=3
